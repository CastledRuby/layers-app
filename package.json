{
  "name": "layers-web",
  "private": true,
  "version": "1.0.30",
  "author": "CastledRuby",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "vite build --config vite.config.local.js",
    "sync:app": "node scripts/sync-app.mjs",
    "docs:map": "node scripts/gen-code-map.mjs",
    "release": "node scripts/release.mjs",
    "install:local": "node scripts/install-local.mjs",
    "brand:render": "electron scripts/render-brand.cjs",
    "build:electron": "npm run build:local && npm run sync:app",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "preview": "vite preview",
    "electron:build:win": "npm run build:electron && electron-builder --win --x64",
    "electron:build:linux": "electron-builder --linux --x64",
    "electron:publish:win": "npm run build:electron && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.42.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.layers.app",
    "productName": "Layers",
    "protocols": [
      {
        "name": "Layers",
        "schemes": [
          "layers"
        ]
      }
    ],
    "asar": true,
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/toasts.cjs",
      "electron/icon.png",
      "electron/icon.ico",
      "electron/tray-icon-dark.png",
      "electron/tray-icon-dark@2x.png",
      "electron/tray-icon-light.png",
      "electron/tray-icon-light@2x.png",
      "electron/app/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico",
      "signtoolOptions": {
        "sign": null
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerSidebar": "electron/installer-sidebar.bmp",
      "shortcutName": "Layers"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/icon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "CastledRuby",
      "repo": "layers-app"
    }
  }
}
