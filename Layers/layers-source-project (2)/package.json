{
  "name": "layers-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "vite build --config vite.config.local.js",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:build:win": "electron-builder --win --x64",
    "electron:build:linux": "electron-builder --linux --x64",
    "electron:publish:win": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.layers.app",
    "productName": "Layers",
    "asar": true,
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/*.png",
      "electron/app/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png",
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "sign": null
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Layers"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/icon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "layers-app"
    }
  }
}
